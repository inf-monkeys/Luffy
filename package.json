{
  "name": "luffy-jev-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.mjs",
    "start": "node --env-file=.env src/server.mjs",
    "check": "node --check src/server.mjs && .venv/bin/python -m py_compile src/opencv_perception.py",
    "setup:vision": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt"
  }
}
