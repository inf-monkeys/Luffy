{
  "name": "luffy-jev-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "node --experimental-websocket --watch --env-file=.env src/server.mjs",
    "start": "node --experimental-websocket --env-file=.env src/server.mjs",
    "live:drive": "node scripts/live_driver.mjs",
    "check": "node --check src/server.mjs && node --check src/runtime.mjs && node --check scripts/live_driver.mjs"
  }
}
