PORT=8787
JEV_PROVIDER=local
LOCAL_JEV_BASE_URL=http://127.0.0.1:8788
LOCAL_JEV_PATH=/v1/judge
# Default local model: OmniJev-4B MLX 5-bit with the released decision head.
JEV_OMNI_MODEL_PATH=/Users/leo/WorkSpace/Luffy/third_party/OmniJev/models/Qwen3.5-4B-OmniJev-MLX-5bit
JEV_OMNI_HEAD_PATH=/Users/leo/WorkSpace/Luffy/third_party/OmniJev/models/OmniJev-4B-ckpt/head.npz
JEV_OMNI_MAX_PIXELS=87808
JEV_REQUEST_TIMEOUT_MS=30000
CONTROLLER_MODE=manual
CONTROLLER_BASE_URL=
CONTROLLER_ACTION_PATH=/v1/action
CONTROLLER_UDP_HOST=192.168.4.1
CONTROLLER_UDP_PORT=8765
CONTROLLER_REQUEST_TIMEOUT_MS=3000
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_API_KEY=
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
OBS_SOURCE_NAME=视频采集设备
# The browser keeps this high-resolution MediaStream for display. The live
# driver opens the shared capture device with this mode, then scales frames
# down to INFERENCE_SIZE before sending them to Jev.
CAPTURE_SOURCE_SIZE=1920x1080
CAPTURE_SOURCE_FRAMERATE=30
# Existing CAPTURE_SIZE/CAPTURE_FRAMERATE remain the inference defaults.
INFERENCE_SIZE=640x480
INFERENCE_FRAMERATE=10
